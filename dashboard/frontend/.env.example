# Frontend configuration. Copy to `.env` to override the auto-derived defaults.
#
# When unset, the app derives every URL from the browser's current hostname
# (window.location.hostname) — so opening http://192.168.2.2:3000 automatically
# targets the Jetson's backend on the same host. Set these only to point the
# frontend at a different host/ports.

# REST API base (no trailing slash).
# VITE_API_URL=http://192.168.2.2:8000

# WebSocket base (host:port, no path). /camera, /telemetry, /ping are appended.
# VITE_WS_URL=ws://192.168.2.2:8001

# Dev server port (also read by vite.config.js as DASH_FRONTEND_PORT).
DASH_FRONTEND_PORT=3000
